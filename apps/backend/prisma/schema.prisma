generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KARYAWAN
}
 
model Karyawan {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  password  String
  role      Role
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@map("karyawan")
}

enum TransactionType {
  PEMASUKAN
  PENGELUARAN
}

model Transaction {
  id        Int             @id @default(autoincrement())
  title     String
  amount    Int
  type      TransactionType
  date      DateTime
  note      String?
  deleted   Boolean         @default(false)
  createdAt DateTime        @default(now())

  // Relasi ke Karyawan
  createdBy   Int
  karyawan    Karyawan @relation(fields: [createdBy], references: [id])

  @@map("transactions")
}